# Copy to staging.env (git-ignored) on the staging host. Staging secrets only; never reuse production values.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME
# Generate: echo "1:$(openssl rand -base64 32)"
GUNKLY_SECRET_KEYS=1:REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
# Public origin of the staging site.
GUNKLY_BASE_URL=http://127.0.0.1:8080
# Image tag to run: a release tag, or "main" for the latest main build.
IMAGE_TAG=main
