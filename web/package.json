{
  "name": "gunkly-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('node:fs').writeFileSync('dist/.gitkeep','')\"",
    "check": "svelte-check --fail-on-warnings && npm run -s i18n-check && node scripts/qr-check.mjs && node scripts/md-check.mjs",
    "i18n-check": "node scripts/i18n-check.mjs",
    "budget": "node scripts/budget.mjs",
    "licenses": "node scripts/licenses.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:idp": "playwright test -c e2e-idp/playwright.config.ts",
    "design-review": "GUNKLY_DESIGN_REVIEW=1 playwright test -c e2e/playwright.config.ts --project=desktop design-review",
    "screenshots": "GUNKLY_SCREENSHOTS=1 playwright test -c e2e/playwright.config.ts --project=desktop screenshots && python3 scripts/shrink-png.py ../docs/assets/screens/*.png"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
