# Gunkly configuration. Copy to .env and fill in. Never commit .env.
# Placeholder values only; every setting below shows its default unless marked required.

# Image tag used by compose.sqlite.yml / compose.postgres.yml: latest (default), or pin a version such as 0.7.
#IMAGE_TAG=latest

# Database: sqlite:///data/gunkly.db (default) or postgres://user:password@host:5432/gunkly?sslmode=require
GUNKLY_DATABASE_URL=sqlite:///data/gunkly.db

# Required. Encryption keys as <version>:<base64 32-byte key>, comma-separated. Generate: openssl rand -base64 32
GUNKLY_SECRET_KEYS=1:REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
# Key version used for new ciphertexts; defaults to the highest version listed above.
GUNKLY_SECRET_KEY_CURRENT=

# Address the HTTP server listens on.
GUNKLY_LISTEN_ADDR=:4865
# Public origin used in links (scheme://host[:port], no path). Required (https) in hosted mode.
GUNKLY_BASE_URL=https://chores.example.com
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For / Forwarded is trusted; empty trusts none.
# Set it when Gunkly runs behind a reverse proxy (e.g. 192.168.1.1/32 or 172.18.0.0/16), or client IPs and
# per-IP rate limits use the proxy's address. The admin panel warns when it sees an untrusted proxy.
# See README, "Behind a reverse proxy".
GUNKLY_TRUSTED_PROXIES=

# Optional: where a sign-in came from, so users get an email about an unusual one (a country they have not
# signed in from, or a hosting/cloud network). Only the country code and a hosting yes/no are stored.
# Nothing is looked up or sent unless a source is available. See README, "Unusual sign-in emails".
# Country header set by a trusted proxy (Cloudflare sends CF-IPCountry); "off" disables it. Needs GUNKLY_TRUSTED_PROXIES.
#GUNKLY_GEOIP_COUNTRY_HEADER=CF-IPCountry
# Header with the AS number, if your proxy adds one (for hosting-network detection); empty = none.
#GUNKLY_GEOIP_ASN_HEADER=
# Paths of MaxMind-format .mmdb files (DB-IP Lite or GeoLite2), read once at start.
#GUNKLY_GEOIP_COUNTRY_DB=/data/dbip-country-lite.mmdb
#GUNKLY_GEOIP_ASN_DB=/data/dbip-asn-lite.mmdb

# Email (verification, password reset, email codes, reminders by email); needs GUNKLY_BASE_URL for the links.
# Easier to set in Administration, Email. Set GUNKLY_EMAIL_ENABLED=true here to configure it in the
# environment instead; then these variables win and the admin page shows them locked.
#GUNKLY_EMAIL_ENABLED=true
# SMTP server host; required when email is enabled. Outbound SMTP goes through the egress guard (always on in hosted mode),
# so a hosted relay must be a public address; self-hosters can reach a LAN relay by turning the guard off in the admin settings.
#GUNKLY_SMTP_HOST=smtp.example.com
# SMTP port.
#GUNKLY_SMTP_PORT=587
# SMTP username.
#GUNKLY_SMTP_USERNAME=gunkly@example.com
# SMTP password.
#GUNKLY_SMTP_PASSWORD=REPLACE_ME
# Sender address; required when email is enabled.
#GUNKLY_SMTP_FROM=Gunkly <gunkly@example.com>
# SMTP transport security: starttls, tls or none (none is refused in hosted mode).
#GUNKLY_SMTP_TLS=starttls

# Public multi-tenant service mode: requires email and an https BASE_URL, enables stricter defaults.
GUNKLY_HOSTED_MODE=false
# Apply pending database migrations on start; when false, Gunkly refuses to start until `gunkly migrate` is run.
GUNKLY_AUTO_MIGRATE=true
# Run this instance as web-only (no reminder scheduler).
GUNKLY_DISABLE_SCHEDULER=false
# Maximum time to finish in-flight requests and sends on SIGTERM.
GUNKLY_SHUTDOWN_TIMEOUT=30s
# Enables GET /metrics (Prometheus text format) for the bearer token given here; unset = no metrics endpoint.
# At least 16 characters. Generate: openssl rand -hex 24. Can also be set in Administration, Connections.
#GUNKLY_METRICS_TOKEN=
# Sign-up proof-of-work difficulty: the largest number a visitor's browser may have to try (1000-1000000; 250000 is a few seconds on a phone).
# Can also be set in Administration, Sign-up & sign-in.
#GUNKLY_SIGNUP_POW_MAX=250000
# Log level: debug, info, warn or error.
GUNKLY_LOG_LEVEL=info

# Single sign-on with an OpenID Connect provider (self-hosted only; see docs/sso.md). Easier to set in
# Administration, Sign-up & sign-in; variables set here win and lock it there. Leave all of these unset to
# keep it off or to set it in the app. It needs GUNKLY_BASE_URL to be an https address (or localhost); the provider redirects back to
# {GUNKLY_BASE_URL}/api/v1/auth/oidc/callback.
# The provider's issuer URL, exactly as in its discovery document.
#GUNKLY_OIDC_ISSUER=https://auth.example.com
# Client ID and secret of the application you created for Gunkly at the provider.
#GUNKLY_OIDC_CLIENT_ID=gunkly
#GUNKLY_OIDC_CLIENT_SECRET=REPLACE_ME
# Label of the sign-in button ("Sign in with Authelia"); empty = "single sign-on".
#GUNKLY_OIDC_NAME=Authelia
# Scopes to ask for; "openid" is always included.
#GUNKLY_OIDC_SCOPES=openid profile email

# AI chore suggestions (optional, off by default). Easier to set in Administration, AI; a
# variable set here wins and locks that field there. Any OpenAI-compatible API: a paid service
# or a model on your own network (Ollama: http://<host>:11434/v1). See docs/ai-chore-suggestions.md.
#GUNKLY_AI_ENABLED=true
#GUNKLY_AI_URL=https://api.openai.com/v1
#GUNKLY_AI_MODEL=gpt-4o-mini
#GUNKLY_AI_KEY=REPLACE_ME

# Update webhook (optional): "Update now" in Administration, Updates asks an updater you run to pull
# the new image and restart Gunkly (Watchtower's HTTP API, a container manager's redeploy webhook, your
# own script). Gunkly sends one POST, with "Authorization: Bearer <token>" when a token is set; it never
# touches Docker itself. Easier to set in Administration, Updates. See docs/updating.md.
#GUNKLY_UPDATE_WEBHOOK_URL=http://watchtower:8080/v1/update
#GUNKLY_UPDATE_WEBHOOK_TOKEN=REPLACE_ME
#GUNKLY_UPDATE_WEBHOOK_KIND=watchtower   # watchtower, portainer, dockhand or other

# Postgres compose file only (compose.postgres.yml): password for the bundled Postgres.
POSTGRES_PASSWORD=REPLACE_ME
# SQLite temporary files; keep inside the data volume for the read-only root filesystem.
SQLITE_TMPDIR=/data/tmp

# Hosted service only (needs GUNKLY_HOSTED_MODE=true): links to its privacy policy and terms, shown at sign-up and sign-in.
#GUNKLY_PRIVACY_URL=https://example.org/privacy
#GUNKLY_TERMS_URL=https://example.org/terms

# Optional: serve /.well-known/security.txt (RFC 9116) with this contact (mailto: or https: URI), and a policy link.
#GUNKLY_SECURITY_CONTACT=mailto:security@example.org
#GUNKLY_SECURITY_POLICY=https://example.org/security-policy
